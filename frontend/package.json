{
  "name": "perfo",
  "version": "0.2.0-rc.13",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:generate:dev": "node scripts/run-prisma-with-env.mjs dev generate",
    "prisma:generate:prod": "node scripts/run-prisma-with-env.mjs prod generate",
    "prisma:generate:docker": "docker compose -f ../docker-compose.yml --env-file ../.env.dev --profile dev exec frontend-dev pnpm prisma:generate",
    "prisma:generate:docker:prod": "docker compose -f ../docker-compose.yml --env-file ../.env --profile dev run --rm --no-deps frontend-dev sh -lc 'pnpm install --no-frozen-lockfile && pnpm prisma:generate:prod'",
    "prisma:migrate:dev": "node scripts/run-prisma-with-env.mjs dev migrate dev",
    "prisma:migrate:prod": "node scripts/run-prisma-with-env.mjs prod migrate dev",
    "prisma:migrate:deploy": "node scripts/run-prisma-with-env.mjs prod migrate deploy",
    "prisma:migrate:status": "node scripts/run-prisma-with-env.mjs prod migrate status",
    "prisma:push": "node scripts/run-prisma-with-env.mjs dev db push",
    "prisma:push:dev": "node scripts/run-prisma-with-env.mjs dev db push",
    "prisma:push:docker": "docker compose -f ../docker-compose.yml --env-file ../.env.dev --profile dev exec frontend-dev pnpm prisma:push",
    "prisma:reset:dev": "node scripts/run-prisma-with-env.mjs dev db push --force-reset",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.3.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@zxing/browser": "^0.2.0",
    "axios": "^1.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.9.2",
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.563.0",
    "next": "16.2.6",
    "next-auth": "^4.24.13",
    "next-intl": "^4.8.3",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "prisma": "^7.3.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  }
}
