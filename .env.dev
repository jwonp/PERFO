# ============================================
# PERFO Development Environment
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=perfo
POSTGRES_PASSWORD=perfo123
POSTGRES_DB=perfo
POSTGRES_PORT=15432

# --- Redis ---
REDIS_PORT=16379

# --- Kafka ---
KAFKA_PORT=19092
ZOOKEEPER_PORT=12181

# --- Backend (Spring Boot) ---
BACKEND_PORT=18080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/perfo
SPRING_DATASOURCE_USERNAME=perfo
SPRING_DATASOURCE_PASSWORD=perfo123
JWT_SECRET=dev-jwt-secret-key-not-for-production-use-min-256-bits

# --- Frontend (Next.js) ---
FRONTEND_PORT=13000
NEXTAUTH_URL=http://localhost:13000
NEXTAUTH_SECRET=dev-nextauth-secret-not-for-production

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:13000
